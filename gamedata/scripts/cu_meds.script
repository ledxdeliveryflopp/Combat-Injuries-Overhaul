local IBUPROFEN_COOLDOWN_MS  = 75000    -- Пауза после ибупрофена (75 сек)
local MORPHINE_COOLDOWN_MS = 300000  -- Пауза после морофия (300 сек)

med_pain_block = {
    ["morphine"]          = MORPHINE_COOLDOWN_MS,
    ["akvatab"]         = IBUPROFEN_COOLDOWN_MS,
}

function OnMedItemUse(item)
    if not item then return end
    local sec = item:section()

    local cooldown = med_pain_block[sec]
    
    if cooldown then
        local now = time_global()
        cu_const.BlockSoundUntil = now + cooldown

        if cu_const.ActivePainSnd and cu_const.ActivePainSnd:playing() and not cu_const.IsFadingOut then
            cu_const.IsFadingOut = true
            cu_const.FadeStartTime = now
        end
    end
end


