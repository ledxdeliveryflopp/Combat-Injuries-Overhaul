-- Файл: gamedata\scripts\cu_pain.script

local pain_volume_levels = {
    low      = 0.5,
    medium   = 1.0,
    heavy    = 1.5,
    critical = 2.0,
}

function StopPainEffect()
    if cu_const.ActivePainSnd and cu_const.ActivePainSnd:playing() and not cu_const.IsFadingOut then
        cu_const.IsFadingOut = true
        cu_const.FadeStartTime = time_global()
    end
end

local function start_pain_sound(pain_volume)
    local target_vol = pain_volume or 0.5

    -- Если звук уже играет (даже если начал затухать) — просто отменяем затухание и ставим громкость
    if cu_const.ActivePainSnd and cu_const.ActivePainSnd:playing() then
        cu_const.IsFadingOut = false
        cu_const.ActivePainSnd.volume = target_vol
        return
    end

    -- Запускаем с нуля только если звук реально остановился
    cu_const.IsFadingOut = false
    cu_const.ActivePainSnd = sound_object("cu_injuries\\agony")
    if cu_const.ActivePainSnd then
        cu_const.ActivePainSnd:play(db.actor, 0, sound_object.s2d + sound_object.looped)
        cu_const.ActivePainSnd.volume = target_vol
    end
end

---@param pain_level "low" | "medium" | "heavy" | "critical"
function StartPainEffect(pain_level)
    if not pain_level then
        cu_effects.StopPainVisualEffect()
        return
    end
    local pain_volume = pain_volume_levels[pain_level] or 0.5
    start_pain_sound(pain_volume)
    if pain_level ~= "low" and pain_level ~= "medium" then
        cu_effects.StartPainVisualEffect(pain_level)
    else
        cu_effects.StopPainVisualEffect()
    end
end

-- ==========================================
-- 1. ОБРАБОТКА РАЗОВОГО ПОПАДАНИЯ (БОЛЕВОЙ ШОК)
-- ==========================================

function GetPainTime()
    local now = time_global()
    local block_until = cu_const.BlockSoundUntil or 0
    local hit_until   = cu_const.HitPainUntil or 0

    -- Показываем время болевого шока, только если он активен И не заглушен обезболивающим
    if hit_until > now and now >= block_until then
        return math.ceil((hit_until - now) / 1000)
    end
    return nil
end
