function SaveState(m_data)
    if not m_data then return end
    local now = time_global()

    -- 1. Обезболивающее
    if cu_const.BlockSoundUntil and cu_const.BlockSoundUntil > now then
        m_data.cu_pain_block_remaining = cu_const.BlockSoundUntil - now
    else
        m_data.cu_pain_block_remaining = nil
    end

    -- 2. Гемоторакс
    if cu_const.HemothoraxUntil and cu_const.HemothoraxUntil > now then
        m_data.cu_hemothorax_remaining = cu_const.HemothoraxUntil - now
    else
        m_data.cu_hemothorax_remaining = nil
    end

    if cu_const.HemothoraxBlockUntil and cu_const.HemothoraxBlockUntil > now then
        m_data.cu_hemothorax_block = cu_const.HemothoraxBlockUntil - now
    else
        m_data.cu_hemothorax_block = nil
    end

    -- 3. Болевой шок от удара
    if cu_const.HitPainUntil and cu_const.HitPainUntil > now then
        m_data.cu_hit_pain_remaining = cu_const.HitPainUntil - now
        m_data.cu_hit_pain_level     = cu_const.HitPainLevel
    else
        m_data.cu_hit_pain_remaining = nil
        m_data.cu_hit_pain_level     = nil
    end

    -- 4. Уровень усталости (сохраняем только если > 0)
    local fat = cu_fatigue and cu_fatigue.GetFatigueNumeric and cu_fatigue.GetFatigueNumeric() or 0
    if fat > 0 then
        m_data.cu_fatigue_level = fat
    else
        m_data.cu_fatigue_level = nil
    end

    m_data.cu_bone_condition = cu_fractured.BonesCondition
    if cu_fractured.BlockFractureUntil and cu_fractured.BlockFractureUntil > 0 then
        m_data.cu_fracture_block = now + cu_fractured.BlockFractureUntil
    else
        cu_fractured.BlockFractureUntil = 0
    end
end

function LoadState(m_data)
    if not m_data then return end
    local now = time_global()

    -- 1. Восстанавливаем обезболивающее
    if m_data.cu_pain_block_remaining and m_data.cu_pain_block_remaining > 0 then
        cu_const.BlockSoundUntil = now + m_data.cu_pain_block_remaining
    else
        cu_const.BlockSoundUntil = 0
    end

    -- 2. Восстанавливаем гемоторакс
    if m_data.cu_hemothorax_remaining and m_data.cu_hemothorax_remaining > 0 then
        cu_const.HemothoraxUntil = now + m_data.cu_hemothorax_remaining
    else
        cu_const.HemothoraxUntil = 0
    end
    
    -- 3. Восстанавливаем блокировку гемоторакса
    if m_data.cu_hemothorax_block and m_data.cu_hemothorax_block > 0 then
        cu_const.HemothoraxBlockUntil = now + m_data.cu_hemothorax_block
    else
        cu_const.HemothoraxBlockUntil = 0
    end

    -- 4. Восстанавливаем болевой шок
    if m_data.cu_hit_pain_remaining and m_data.cu_hit_pain_remaining > 0 then
        cu_const.HitPainUntil     = now + m_data.cu_hit_pain_remaining
        cu_const.HitPainLevel     = m_data.cu_hit_pain_level or "low"
        cu_const.CurrentPainLevel = cu_const.HitPainLevel
    else
        cu_const.HitPainUntil = 0
        cu_const.HitPainLevel = "low"
    end

    -- 5. Восстанавливаем уровень усталости
    if cu_fatigue and cu_fatigue.SetFatigueNumeric then
        cu_fatigue.SetFatigueNumeric(m_data.cu_fatigue_level or 0)
    end

    cu_fractured.BonesCondition =  m_data.cu_bone_condition
    
    if m_data.cu_fracture_block and m_data.cu_fracture_block > 0 then
        cu_const.HemothoraxBlockUntil = now + m_data.cu_fracture_block
    else
        cu_fractured.BlockFractureUntil = 0
    end
end
