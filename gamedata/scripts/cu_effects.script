-- Файл: gamedata\scripts\cu_effects.script

local knockout_timer_start = nil
local is_knocked_out       = false
local active_ko_snd        = nil

local BLACKOUT_PP_ID    = 8850
local BLACKOUT_DURATION = 8.0  -- Общая длительность темноты (сек)
local FADE_IN_DURATION  = 5.0  -- Плавное потемнение (сек)
local SLEEP_HOURS       = 2    -- Промотка времени при потере сознания (часы)

local visual_intensity_levels = {
    low      = 0.25, -- Лёгкое двоение по краям
    medium   = 0.45, -- Умеренное размытие
    heavy    = 0.65, -- Сильное размытие
    critical = 0.85, -- Тяжёлая дезориентация
}

local current_visual_base = 0.45

-- ==========================================
-- ВИЗУАЛЬНЫЕ ЭФФЕКТЫ
-- ==========================================

function StopPainVisualEffect()
    if cu_const.PP_Active then
        cu_const.PP_Active = false
        level.remove_pp_effector(cu_const.PP_EFFECT_ID)
    end
end

---@param pain_level "low" | "medium" | "heavy" | "critical"
function StartPainVisualEffect(pain_level)
    -- Обновляем целевую силу размытия под текущий уровень боли
    current_visual_base = visual_intensity_levels[pain_level] or 0.45

    if not cu_const.PP_Active then
        cu_const.PP_Active = true
        level.add_pp_effector("alcohol.ppe", cu_const.PP_EFFECT_ID, true)
    end
end

function UpdatePainVisualEffect(current_game_time)
    if not current_game_time then return end

    if cu_const.IsFadingOut and cu_const.ActivePainSnd then
        if cu_const.ActivePainSnd:playing() then
            local fade_ms = 12 * 1000
            local progress = (current_game_time - cu_const.FadeStartTime) / fade_ms
            if progress >= 1.0 then
                cu_const.ActivePainSnd:stop()
                cu_const.IsFadingOut = false
                StopPainVisualEffect()
            else
                local remaining = 1.0 - progress
                cu_const.ActivePainSnd.volume = remaining

                -- Плавно гасим экран от текущей силы боли (current_visual_base) до 0
                if cu_const.PP_Active then
                    level.set_pp_effector_factor(cu_const.PP_EFFECT_ID, current_visual_base * remaining)
                end
            end
        else
            cu_const.IsFadingOut = false
            StopPainVisualEffect()
        end
    elseif cu_const.PP_Active and not cu_const.IsFadingOut then
        -- Пульсация масштабируется пропорционально силе боли (±20% от базового уровня)
        local amplitude = current_visual_base * 0.2
        local pulse = current_visual_base + math.sin(current_game_time * 0.004) * amplitude
        level.set_pp_effector_factor(cu_const.PP_EFFECT_ID, pulse)
    end
end

-- ==========================================
-- ПОТЕРЯ СОЗНАНИЯ
-- ==========================================

function IsKnockedOut()
    return is_knocked_out == true
end

function DropKnockoutTime()
    knockout_timer_start = nil
end

local function ForceStopAgony()
    if cu_const.ActivePainSnd then
        if cu_const.ActivePainSnd:playing() then
            cu_const.ActivePainSnd:stop()
        end
        cu_const.ActivePainSnd = nil
    end
    cu_const.IsFadingOut = false
    StopPainVisualEffect()
end

function ResetKnockout()
    knockout_timer_start = nil
    if active_ko_snd and active_ko_snd:playing() then
        active_ko_snd:stop()
        active_ko_snd = nil
    end
    level.remove_pp_effector(BLACKOUT_PP_ID)
    level.remove_pp_effector(8847)
    if is_knocked_out then
        level.enable_input()
        is_knocked_out = false
    end
    RemoveTimeEvent("cu_injuries", "knockout_fade_in")
    RemoveTimeEvent("cu_injuries", "knockout_sleep")
    RemoveTimeEvent("cu_injuries", "knockout_fade_out")
    RemoveTimeEvent("cu_injuries", "knockout_wake")
    RemoveTimeEvent("cu_injuries", "knockout_snd_fade")
end

function DeathPainEffect()
    cu_const.HemothoraxUntil = 0
    ForceStopAgony()
    ResetKnockout()
end

function UpdateKnockoutTimer()
    if not db.actor or not db.actor:alive() or is_knocked_out then return end

    local now = time_global()
    if not knockout_timer_start then
        knockout_timer_start = now
        return
    end

    local knockout_delay = (cu_injuries_mcm.get_config("knockout_timeout") or 60) * 1000
    if (now - knockout_timer_start) >= knockout_delay then
        knockout_timer_start = nil
        TriggerKnockout()
    end
end

function TriggerKnockout()
    if is_knocked_out or not db.actor or not db.actor:alive() then return end
    is_knocked_out = true

    -- 1. Полностью прекращаем звук и визуал агонии
    ForceStopAgony()

    -- 2. Блокируем управление, прячем оружие, запускаем падение камеры и плавное потемнение
    level.disable_input()
    db.actor:hide_weapon()
    level.add_cam_effector("camera_effects\\surge_02.anm", 8846, false, "")
    level.add_pp_effector("surge_fade.ppe", 8847, false)

    level.add_pp_effector("black.ppe", BLACKOUT_PP_ID, true)
    level.set_pp_effector_factor(BLACKOUT_PP_ID, 0.0)

    local random_path = cu_const.KnockoutSounds[math.random(#cu_const.KnockoutSounds)]
    active_ko_snd = sound_object(random_path)
    if active_ko_snd then
        active_ko_snd:play(db.actor, 0, sound_object.s2d)
        active_ko_snd.volume = 1.0
    end

    -- 3. Плавное нарастание черноты экрана (0.0 -> 1.0)
    local fade_in_start = time_global()
    local fade_in_ms    = (FADE_IN_DURATION or 5.0) * 1000

    CreateTimeEvent("cu_injuries", "knockout_fade_in", 0.02, function()
        if not is_knocked_out or not db.actor or not db.actor:alive() then
            return true
        end

        local progress = (time_global() - fade_in_start) / fade_in_ms
        if progress >= 1.0 then
            level.set_pp_effector_factor(BLACKOUT_PP_ID, 1.0)
            return true
        else
            level.set_pp_effector_factor(BLACKOUT_PP_ID, progress)
        end

        return false
    end)

    -- 4. Пробуждение через BLACKOUT_DURATION секунд
    CreateTimeEvent("cu_injuries", "knockout_sleep", BLACKOUT_DURATION or 8.0, function()
        RemoveTimeEvent("cu_injuries", "knockout_fade_in")

        if not db.actor or not db.actor:alive() then
            ResetKnockout()
            return true
        end

        -- Проверка среднего кровотечения
        local bleeding_level = db.actor.bleeding or 0
        local had_medium_bleed = (bleeding_level >= 0.25)

        if had_medium_bleed and math.random(1, 100) <= 25 then
            ResetKnockout()
            db.actor:kill(db.actor)
            return true
        end

        -- Проматываем время и выставляем HP
        level.change_game_time(0, SLEEP_HOURS or 2, 0)
        surge_manager.get_surge_manager().time_forwarded = true

        if had_medium_bleed then
            db.actor:set_health_ex(0.05)
        elseif db.actor.health < 0.18 then
            db.actor:set_health_ex(0.18)
        end

        -- Укладываем камеру на землю до рассеивания темноты
        level.remove_pp_effector(8847)
        level.add_cam_effector("camera_effects\\prison_1.anm", 8848, false, "")
        level.add_pp_effector("yantar_underground_psi.ppe", 8849, false)
        level.set_pp_effector_factor(8849, 0.5)

        -- Плавное рассеивание чёрного экрана (1.0 -> 0.0)
        local fade_out_start = time_global()
        local fade_out_ms    = 2200

        CreateTimeEvent("cu_injuries", "knockout_fade_out", 0.02, function()
            local progress = (time_global() - fade_out_start) / fade_out_ms
            if progress >= 1.0 then
                level.remove_pp_effector(BLACKOUT_PP_ID)
                return true
            else
                level.set_pp_effector_factor(BLACKOUT_PP_ID, 1.0 - progress)
            end
            return false
        end)

        -- Плавное затухание звука ПОСЛЕ открытия глаз
        local fade_start    = time_global()
        local fade_duration = 2500

        CreateTimeEvent("cu_injuries", "knockout_snd_fade", 0.05, function()
            if not active_ko_snd or not active_ko_snd:playing() then
                active_ko_snd = nil
                return true
            end

            local progress = (time_global() - fade_start) / fade_duration
            if progress >= 1.0 then
                active_ko_snd:stop()
                active_ko_snd = nil
                return true
            else
                active_ko_snd.volume = 1.0 - progress
            end

            return false
        end)

        -- Возвращаем управление через 2.2 секунды
        CreateTimeEvent("cu_injuries", "knockout_wake", 2.2, function()
            level.enable_input()
            db.actor:restore_weapon()
            is_knocked_out = false
            return true
        end)

        return true
    end)
end

function RandomizeHemothorax(current_game_time)
    printf("[CU_Injuries] Start hemothorax")
    cu_const.HemothoraxUntil = math.max(cu_const.HemothoraxUntil or 0, current_game_time + 25000)
    local hemothorax_chance = cu_injuries_mcm.get_config("hemothorax_chance")
    if math.random(1, 100) <= hemothorax_chance then
        cu_const.HemothoraxUntil = math.max(cu_const.HemothoraxUntil or 0, current_game_time + 180000) -- 3 минуты
        news_manager.send_tip(db.actor, game.translate_string("st_cu_hemothorax_start"), nil, nil, 5000)
    end
end

function CheckHemothoraxStatus(current_game_time)
    if (cu_const.HemothoraxUntil or 0) > current_game_time then
        local cond = db.actor:cast_Actor():conditions()
        local cur_bleed = db.actor.bleeding or 0

        -- Поддерживаем строго среднее кровотечение (0.25 - 0.45), не доводя до критического красного
        if cur_bleed < 0.25 and cond and cond.AddWound then
            cond:AddWound(0.18, hit.wound, 15)
        end

        -- Ограничение максимальной выносливости при кровопотере
        local time_left_ratio = (cu_const.HemothoraxUntil - current_game_time) / 180000 -- от 1.0 в начале до 0.0 в конце
        local max_stamina_limit = 0.25 + (0.35 * time_left_ratio)  
        if db.actor.power > max_stamina_limit then
            db.actor.power = max_stamina_limit
        end
    end
end
